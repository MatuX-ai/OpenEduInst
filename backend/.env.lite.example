# ============================================================
# OpenMT 入门型套餐 (2核 2GB) - 生产环境变量
#   复制: cp .env.lite.example .env  &&  chmod 600 .env
#   启动: docker compose -f docker-compose.lite.yml --env-file .env up -d
# ============================================================

# ---- 运行环境 ----
ENV=prod

# ---- 数据库：Neon (https://neon.tech 免费 0.5GB)
#    1) 注册 Neon -> 创建项目 openmt-prod
#    2) Dashboard -> Connection Details -> Pooled connection
#    3) 形如: postgresql://neondb_owner:xxx@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ---- JWT 密钥：48+ 字节随机 ----
#    生成: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=PLEASE_RUN_python_-c_import_secrets_print_secrets_token_urlsafe_48_TO_GENERATE

ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Redis（容器内部，勿改）----
REDIS_URL=redis://redis:6379/0

# ---- CORS：精确列出前端域名（逗号分隔，无空格）----
CORS_ALLOW_ORIGINS=https://app.yourschool.com,https://admin.yourschool.com

# ---- HTTPS ----
ENFORCE_HTTPS=1

# ---- 限流（入门型已下调）----
RL_ANON_LIMIT=30
RL_AUTH_LIMIT=300
RL_LOGIN_LIMIT=5

# ---- Demo 模式（1 = 只读）----
DEMO_MODE=0

# ---- Gunicorn（与 docker-compose.lite.yml 一致）----
WORKERS=2
LOG_LEVEL=warning

# ---- 外部集成（按需留空）----
IMATU_API_BASE=https://api.imatu.com
IMATU_API_KEY=
IMATU_SECRET_KEY=

OPENSCIEDU_API_BASE=https://opensciedu.matux.tech/api
OPENSCIEDU_API_KEY=
