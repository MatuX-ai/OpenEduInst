# ========== OpenMT 后端环境变量模板 ==========
# 复制为 .env 并填入真实值，切勿提交 .env 到仓库。

ENV=prod

# ---- 数据库 ----
DATABASE_URL=postgresql://openmt_user:CHANGE_ME@db:5432/openmt_edu_inst

# ---- JWT ----
# 推荐：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME__use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Celery（定时/异步任务；broker/backend 使用 Redis 的不同 DB）----
CELERY_ENABLED=1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TIMEZONE=Asia/Shanghai

# ---- 邮件（续费/到期提醒 + 欢迎邮件）----
# provider: smtp | sendgrid | log（开发模式，写入 logs/emails.log）
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
EMAIL_FROM=noreply@yourschool.com
SENDGRID_API_KEY=

# 前端基础 URL（用于邮件里的续费链接拼接）
FRONTEND_BASE_URL=https://admin.yourschool.com

# ---- CORS ----
# 以英文逗号分隔；生产必须显式列出前端域名
CORS_ALLOW_ORIGINS=https://app.yourschool.com,https://admin.yourschool.com

# ---- HTTPS ----
# 1 = 启用 HSTS 并将 refresh cookie 标记为 secure
ENFORCE_HTTPS=1

# ---- Demo ----
DEMO_MODE=0

# ---- 外部集成 ----
IMATU_API_BASE=https://api.imatu.com
IMATU_API_KEY=
IMATU_SECRET_KEY=CHANGE_ME

OPENSCIEDU_API_BASE=https://opensciedu.matux.tech/api
OPENSCIEDU_API_KEY=

# ---- LLM 助教（OpenAI 兼容协议）----
# provider: mock（默认离线，不消耗 API 额度）/ openai / deepseek / qwen
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.6
# 1=LLM 异常时自动降级到规则引擎，0=异常向上抛出
LLM_FALLBACK_TO_RULES=1
