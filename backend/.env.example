# ========== OpenMT 后端环境变量模板 ==========
# 复制为 .env 并填入真实值，切勿提交 .env 到仓库。

ENV=prod

# ---- 数据库 ----
DATABASE_URL=postgresql://openmt_user:CHANGE_ME@db:5432/openmt_edu_inst

# ---- JWT ----
# 推荐：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME__use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- CORS ----
# 以英文逗号分隔；生产必须显式列出前端域名
CORS_ALLOW_ORIGINS=https://app.yourschool.com,https://admin.yourschool.com

# ---- HTTPS ----
# 1 = 启用 HSTS 并将 refresh cookie 标记为 secure
ENFORCE_HTTPS=1

# ---- Demo ----
DEMO_MODE=0

# ---- 外部集成 ----
IMATU_API_BASE=https://api.imatu.com
IMATU_API_KEY=
IMATU_SECRET_KEY=CHANGE_ME

OPENSCIEDU_API_BASE=https://opensciedu.matux.tech/api
OPENSCIEDU_API_KEY=
