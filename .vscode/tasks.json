{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔨 Deploy: Full (Build + Deploy)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/backend/deploy/deploy-remote.sh",
                "root@43.156.248.107",
                "-f", "docker-compose.lite.yml"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "完整部署：上传代码 + 构建 Docker 镜像 + 启动服务"
        },
        {
            "label": "🚀 Deploy: Quick Restart (Skip Upload)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/backend/deploy/deploy-remote.sh",
                "root@43.156.248.107",
                "--no-build",
                "--skip-upload",
                "-f", "docker-compose.lite.yml"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "快速重启：不重新上传代码和构建，仅重启 Docker 服务"
        },
        {
            "label": "📦 Deploy: Build Only (No Upload)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/backend/deploy/deploy-remote.sh",
                "root@43.156.248.107",
                "--skip-upload",
                "-f", "docker-compose.lite.yml"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "仅构建：服务器已有最新代码，重新构建 Docker 镜像并启动"
        },
        {
            "label": "🔍 Deploy: Server Health Check",
            "type": "shell",
            "command": "ssh",
            "args": [
                "root@43.156.248.107",
                "cd /opt/openmt/backend && docker compose -f docker-compose.lite.yml ps && echo '---' && curl -s http://127.0.0.1:8000/health"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "远程健康检查：查看容器状态和 API 健康端点"
        },
        {
            "label": "📋 Deploy: View Server Logs",
            "type": "shell",
            "command": "ssh",
            "args": [
                "root@43.156.248.107",
                "cd /opt/openmt/backend && docker compose -f docker-compose.lite.yml logs -f --tail=200"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "查看服务器实时日志（按 Ctrl+C 退出）"
        },
        {
            "label": "⬇️ Deploy: Pull Git + Rebuild",
            "type": "shell",
            "command": "ssh",
            "args": [
                "root@43.156.248.107",
                "cd /opt/openmt && git pull origin feature/marketing-site-docker && cd backend && docker compose -f docker-compose.lite.yml up -d --build api marketing && docker compose -f docker-compose.lite.yml restart nginx"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "Git 同步：在服务器上 pull 最新代码并重建容器（无需上传）"
        }
    ]
}
