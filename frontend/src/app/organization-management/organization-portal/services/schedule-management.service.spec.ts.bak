/**
 * 排课管理服务单元测试
 *
 * @fileoverview 测试排课管理的核心业务逻辑
 * @author AI Assistant
 * @date 2026-04-04
 */

import { TestBed } from '@angular/core/testing';

import { ScheduleManagementService } from './schedule-management.service';
import { CreateScheduleRequest, UpdateScheduleRequest } from '../models/schedule.models';

describe('ScheduleManagementService', () => {
  let service: ScheduleManagementService;

  beforeEach(() => {
    TestBed.configureTestingModule({});
    service = TestBed.inject(ScheduleManagementService);
  });

  it('should be created', () => {
    expect(service).toBeTruthy();
  });

  describe('getScheduleList()', () => {
    it('should return schedule list with pagination', (done) => {
      service.getScheduleList({ page: 1, pageSize: 10 }).subscribe((response) => {
        expect(response).toBeDefined();
        expect(response.data).toBeDefined();
        expect(response.total).toBeGreaterThanOrEqual(0);
        done();
      });
    });

    it('should filter schedules by keyword', (done) => {
      service.getScheduleList({ keyword: '数学' }).subscribe((response) => {
        expect(response.data.length).toBeGreaterThanOrEqual(0);
        done();
      });
    });

    it('should filter schedules by status', (done) => {
      service.getScheduleList({ status: 'scheduled' }).subscribe((response) => {
        response.data.forEach((schedule) => {
          expect(schedule.status).toBe('scheduled');
        });
        done();
      });
    });
  });

  describe('getScheduleDetail()', () => {
    it('should return schedule detail for valid id', (done) => {
      service.getScheduleDetail(1).subscribe((detail) => {
        expect(detail).toBeDefined();
        expect(detail.id).toBe(1);
        expect(detail.course).toBeDefined();
        expect(detail.classroom).toBeDefined();
        expect(detail.students).toBeDefined();
        done();
      });
    });

    it('should throw error for invalid id', (done) => {
      service.getScheduleDetail(9999).subscribe({
        error: (error) => {
          expect(error.message).toContain('不存在');
          done();
        },
      });
    });
  });

  describe('createSchedule()', () => {
    it('should create a new schedule successfully', (done) => {
      const request: CreateScheduleRequest = {
        courseId: 1,
        classroomId: 1,
        teacherId: 1,
        dayOfWeek: 'Monday',
        startTime: '09:00',
        endTime: '10:00',
        studentIds: [1, 2, 3],
      };

      service.createSchedule(request).subscribe((schedule) => {
        expect(schedule).toBeDefined();
        expect(schedule.courseId).toBe(1);
        expect(schedule.status).toBe('scheduled');
        done();
      });
    });
  });

  describe('updateSchedule()', () => {
    it('should update schedule information successfully', (done) => {
      const request: UpdateScheduleRequest = {
        notes: '更新后的备注',
      };

      service.updateSchedule(1, request).subscribe((schedule) => {
        expect(schedule.notes).toBe('更新后的备注');
        expect(schedule.updatedAt).toBeDefined();
        done();
      });
    });

    it('should throw error when updating non-existent schedule', (done) => {
      const request: UpdateScheduleRequest = { notes: '测试' };
      service.updateSchedule(9999, request).subscribe({
        error: (error) => {
          expect(error.message).toContain('不存在');
          done();
        },
      });
    });
  });

  describe('deleteSchedule()', () => {
    it('should delete schedule successfully', (done) => {
      service.deleteSchedule(1).subscribe((result) => {
        expect(result).toBeTrue();
        done();
      });
    });

    it('should return false when deleting non-existent schedule', (done) => {
      service.deleteSchedule(9999).subscribe((result) => {
        expect(result).toBeFalse();
        done();
      });
    });
  });

  describe('getClassrooms()', () => {
    it('should return classroom list', (done) => {
      service.getClassrooms().subscribe((classrooms) => {
        expect(classrooms).toBeDefined();
        expect(Array.isArray(classrooms)).toBeTrue();
        expect(classrooms.length).toBeGreaterThan(0);
        done();
      });
    });
  });

  describe('getCourses()', () => {
    it('should return course list', (done) => {
      service.getCourses().subscribe((courses) => {
        expect(courses).toBeDefined();
        expect(Array.isArray(courses)).toBeTrue();
        expect(courses.length).toBeGreaterThan(0);
        done();
      });
    });
  });

  describe('checkConflict()', () => {
    it('should detect scheduling conflicts', (done) => {
      const request: CreateScheduleRequest = {
        courseId: 1,
        classroomId: 1,
        teacherId: 1,
        dayOfWeek: 'Monday',
        startTime: '09:00',
        endTime: '10:00',
        studentIds: [1, 2],
      };

      service.checkConflict(request).subscribe((conflicts) => {
        expect(conflicts).toBeDefined();
        expect(Array.isArray(conflicts)).toBeTrue();
        done();
      });
    });
  });

  describe('getStats()', () => {
    it('should return comprehensive schedule statistics', (done) => {
      service.getStats().subscribe((stats) => {
        expect(stats).toBeDefined();
        expect(stats.totalSchedules).toBeGreaterThanOrEqual(0);
        expect(stats.scheduledCount).toBeGreaterThanOrEqual(0);
        expect(stats.ongoingCount).toBeGreaterThanOrEqual(0);
        expect(stats.completedCount).toBeGreaterThanOrEqual(0);
        done();
      });
    });
  });
});
