/**
 * 教师管理服务单元测试
 *
 * @fileoverview 测试教师管理的核心业务逻辑
 * @author AI Assistant
 * @date 2026-04-04
 */

import { TestBed } from '@angular/core/testing';

import { TeacherManagementService } from './teacher-management.service';
import {
  CreateTeacherRequest,
  UpdateTeacherRequest,
  BatchOperationRequest,
  AssignCourseRequest,
  TeacherStatus,
} from '../models/teacher.models';

describe('TeacherManagementService', () => {
  let service: TeacherManagementService;

  beforeEach(() => {
    TestBed.configureTestingModule({});
    service = TestBed.inject(TeacherManagementService);
  });

  it('should be created', () => {
    expect(service).toBeTruthy();
  });

  describe('getTeachers()', () => {
    it('should return all teachers when no filter is provided', (done) => {
      service.getTeachers().subscribe((teachers) => {
        expect(teachers).toBeDefined();
        expect(teachers.length).toBeGreaterThan(0);
        done();
      });
    });

    it('should filter teachers by department', (done) => {
      const filter = { department: '数学组' };
      service.getTeachers(filter).subscribe((teachers) => {
        teachers.forEach((teacher) => {
          expect(teacher.department).toBe('数学组');
        });
        done();
      });
    });

    it('should filter teachers by status', (done) => {
      const filter = { status: 'active' as TeacherStatus };
      service.getTeachers(filter).subscribe((teachers) => {
        teachers.forEach((teacher) => {
          expect(teacher.status).toBe('active');
        });
        done();
      });
    });

    it('should filter teachers by search keyword', (done) => {
      const filter = { search: '张' };
      service.getTeachers(filter).subscribe((teachers) => {
        teachers.forEach((teacher) => {
          expect(
            teacher.name.toLowerCase().includes('张') ||
            teacher.email.toLowerCase().includes('张')
          ).toBeTrue();
        });
        done();
      });
    });

    it('should sort teachers by specified field in ascending order', (done) => {
      const filter = { sortBy: 'name' as keyof import('../models/teacher.models').Teacher, sortOrder: 'asc' as 'asc' | 'desc' };
      service.getTeachers(filter).subscribe((teachers) => {
        for (let i = 1; i < teachers.length; i++) {
          expect(teachers[i - 1].name <= teachers[i].name).toBeTrue();
        }
        done();
      });
    });

    it('should paginate teachers correctly', (done) => {
      const filter = { page: 1, pageSize: 5 };
      service.getTeachers(filter).subscribe((teachers) => {
        expect(teachers.length).toBeLessThanOrEqual(5);
        done();
      });
    });
  });

  describe('getTeacherById()', () => {
    it('should return teacher detail for valid id', (done) => {
      service.getTeacherById(1).subscribe((detail) => {
        expect(detail).toBeDefined();
        expect(detail.id).toBe(1);
        expect(detail.courses).toBeDefined();
        expect(detail.reviews).toBeDefined();
        expect(detail.workStats).toBeDefined();
        expect(detail.historyRecords).toBeDefined();
        done();
      });
    });

    it('should throw error for invalid id', () => {
      expect(() => service.getTeacherById(9999)).toThrowError('Teacher 9999 not found');
    });
  });

  describe('createTeacher()', () => {
    it('should create a new teacher successfully', (done) => {
      const request: CreateTeacherRequest = {
        name: '测试老师',
        email: 'test@school.edu.cn',
        phone: '13800138000',
        department: '数学组',
        position: '高级教师',
        hireDate: '2026-04-04',
      };

      service.createTeacher(request).subscribe((teacher) => {
        expect(teacher).toBeDefined();
        expect(teacher.name).toBe('测试老师');
        expect(teacher.email).toBe('test@school.edu.cn');
        expect(teacher.status).toBe('active');
        expect(teacher.courseCount).toBe(0);
        expect(teacher.rating).toBe(0);
        expect(teacher.id).toBeGreaterThan(0);
        done();
      });
    });

    it('should add new teacher to the list', (done) => {
      const request: CreateTeacherRequest = {
        name: '新增老师',
        email: 'new@school.edu.cn',
        phone: '13800138001',
        department: '英语组',
        position: '教师',
        hireDate: '2026-04-04',
      };

      service.createTeacher(request).subscribe(() => {
        service.getTeachers().subscribe((teachers) => {
          const newTeacher = teachers.find((t) => t.email === 'new@school.edu.cn');
          expect(newTeacher).toBeDefined();
          done();
        });
      });
    });
  });

  describe('updateTeacher()', () => {
    it('should update teacher information successfully', (done) => {
      const request: UpdateTeacherRequest = {
        name: '更新后的名字',
        phone: '13900000000',
      };

      service.updateTeacher(1, request).subscribe((teacher) => {
        expect(teacher.name).toBe('更新后的名字');
        expect(teacher.phone).toBe('13900000000');
        expect(teacher.updatedAt).toBeDefined();
        done();
      });
    });

    it('should throw error when updating non-existent teacher', () => {
      const request: UpdateTeacherRequest = { name: '测试' };
      expect(() => service.updateTeacher(9999, request)).toThrowError('Teacher 9999 not found');
    });
  });

  describe('deleteTeacher()', () => {
    it('should soft delete teacher by setting status to inactive', (done) => {
      service.deleteTeacher(1).subscribe((result) => {
        expect(result).toBeTrue();

        service.getTeacherById(1).subscribe((detail) => {
          expect(detail.status).toBe('inactive');
          done();
        });
      });
    });

    it('should return false when deleting non-existent teacher', (done) => {
      service.deleteTeacher(9999).subscribe((result) => {
        expect(result).toBeFalse();
        done();
      });
    });
  });

  describe('batchOperation()', () => {
    it('should batch delete teachers', (done) => {
      const request: BatchOperationRequest = {
        operation: 'delete',
        teacherIds: [1, 2],
      };

      service.batchOperation(request).subscribe((result) => {
        expect(result).toBeTrue();

        service.getTeachers({ status: 'inactive' }).subscribe((teachers) => {
          const deletedTeachers = teachers.filter((t) => t.id === 1 || t.id === 2);
          expect(deletedTeachers.length).toBe(2);
          done();
        });
      });
    });

    it('should batch change teacher status', (done) => {
      const request: BatchOperationRequest = {
        operation: 'change_status',
        teacherIds: [3, 4],
        data: { status: 'on_leave' },
      };

      service.batchOperation(request).subscribe((result) => {
        expect(result).toBeTrue();

        service.getTeachers({ status: 'on_leave' }).subscribe((teachers) => {
          const updatedTeachers = teachers.filter((t) => t.id === 3 || t.id === 4);
          expect(updatedTeachers.length).toBe(2);
          done();
        });
      });
    });

    it('should batch change teacher department', (done) => {
      const request: BatchOperationRequest = {
        operation: 'change_department',
        teacherIds: [5, 6],
        data: { department: '物理组' },
      };

      service.batchOperation(request).subscribe((result) => {
        expect(result).toBeTrue();

        service.getTeachers({ department: '物理组' }).subscribe((teachers) => {
          const updatedTeachers = teachers.filter((t) => t.id === 5 || t.id === 6);
          expect(updatedTeachers.length).toBe(2);
          done();
        });
      });
    });
  });

  describe('assignCourse()', () => {
    it('should increment course count when assigning course', (done) => {
      service.getTeacherById(1).subscribe((beforeDetail) => {
        const beforeCount = beforeDetail.courseCount;

        const request: AssignCourseRequest = {
          teacherId: 1,
          courseId: 101,
          startDate: '2026-04-04',
        };

        service.assignCourse(request).subscribe((result) => {
          expect(result).toBeTrue();

          service.getTeacherById(1).subscribe((afterDetail) => {
            expect(afterDetail.courseCount).toBe(beforeCount + 1);
            done();
          });
        });
      });
    });

    it('should return false when assigning course to non-existent teacher', (done) => {
      const request: AssignCourseRequest = {
        teacherId: 9999,
        courseId: 101,
        startDate: '2026-04-04',
      };

      service.assignCourse(request).subscribe((result) => {
        expect(result).toBeFalse();
        done();
      });
    });
  });

  describe('getStats()', () => {
    it('should return comprehensive teacher statistics', (done) => {
      service.getStats().subscribe((stats) => {
        expect(stats).toBeDefined();
        expect(stats.totalTeachers).toBeGreaterThan(0);
        expect(stats.activeTeachers).toBeGreaterThanOrEqual(0);
        expect(stats.inactiveTeachers).toBeGreaterThanOrEqual(0);
        expect(stats.onLeaveTeachers).toBeGreaterThanOrEqual(0);
        expect(stats.averageRating).toBeGreaterThanOrEqual(0);
        expect(stats.totalCourses).toBeGreaterThanOrEqual(0);
        expect(stats.totalStudents).toBeGreaterThanOrEqual(0);
        expect(stats.departmentStats).toBeDefined();
        expect(Array.isArray(stats.departmentStats)).toBeTrue();
        done();
      });
    });

    it('should calculate correct total from department stats', (done) => {
      service.getStats().subscribe((stats) => {
        const deptTotal = stats.departmentStats.reduce((sum, dept) => sum + dept.count, 0);
        expect(deptTotal).toBe(stats.totalTeachers);
        done();
      });
    });
  });

  describe('getDepartments()', () => {
    it('should return unique department list', (done) => {
      service.getDepartments().subscribe((departments) => {
        expect(departments).toBeDefined();
        expect(Array.isArray(departments)).toBeTrue();
        expect(departments.length).toBeGreaterThan(0);

        // Check uniqueness
        const uniqueDepts = new Set(departments);
        expect(uniqueDepts.size).toBe(departments.length);
        done();
      });
    });
  });
});
